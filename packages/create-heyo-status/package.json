{
  "name": "@heyo-sh/create-heyo-status",
  "version": "0.3.1",
  "description": "Create a standalone Heyo Status project.",
  "keywords": [
    "status-page",
    "uptime",
    "monitoring",
    "scaffolding",
    "create"
  ],
  "homepage": "https://heyo.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyo-sh/heyo-status.git",
    "directory": "packages/create-heyo-status"
  },
  "bugs": {
    "url": "https://github.com/heyo-sh/heyo-status/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "create-heyo-status": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "deployments",
    "databases",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  },
  "scripts": {
    "dev": "bun run build --watch",
    "build": "bun build src/index.ts --outdir dist --target node --production --external @clack/prompts && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  }
}

{
  "name": "{{PROJECT_NAME}}",
  "private": true,
  "type": "module",
  "packageManager": "{{PACKAGE_MANAGER}}",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "dev": "heyo-status dev -- bunx --bun react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "check": "heyo-status check run",
    "db:migrate": "heyo-status db migrate",
    "db:seed": "heyo-status db seed --uptime 99.95 --days 90"
  },
  "dependencies": {
    "@heyo-sh/heyo-status": "{{HEYO_STATUS_VERSION}}",
    "@react-router/dev": "^7.0.0",
    "@react-router/node": "^7.0.0",
    "@react-router/serve": "^7.0.0",
    "@tailwindcss/postcss": "^4.1.14",
    "isbot": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}

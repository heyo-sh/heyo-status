# SQLite is the default local database. Use an absolute path in production.
HEYO_STATUS_DB_PATH=status.sqlite
# Required by the Vercel cron overlay. Its routes stay closed without it.
# CRON_SECRET=replace-me
# Required when using PostgreSQL.
# DATABASE_URL=postgres://user:password@host/database
# Bearer token for the /api/heyo-status/admin/* management endpoints.
# HEYO_STATUS_API_TOKEN=replace-me

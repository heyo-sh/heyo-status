---
import { StatusPage } from "@heyo-sh/heyo-status/ui";
import { statusThemeBootstrapScript } from "@heyo-sh/heyo-status/theme/script";
import "@heyo-sh/heyo-status/theme/status.css";
import "../styles/status.css";
import { requestStatusPage } from "../../cloudflare-status-page";

export const prerender = false;
const statusPage = await requestStatusPage();
const snapshot = await statusPage.api.getSnapshot();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{statusPage.title}</title>
    <meta name="description" content={statusPage.description} />
    <script
      is:inline
      set:html={statusThemeBootstrapScript(undefined, statusPage.mode)}
    />
  </head>
  <body>
    <StatusPage
      client:load
      branding={statusPage.branding}
      colors={statusPage.colors}
      metrics={statusPage.metrics}
      mode={statusPage.mode}
      incidentsEnabled={statusPage.incidents.enabled}
      maintenanceEnabled={statusPage.maintenance.enabled}
      basePath={statusPage.basePath}
      snapshot={snapshot}
      subscribersEnabled={statusPage.subscribers.enabled}
      subscriberMethods={statusPage.subscribers.methods}
      theme={statusPage.theme}
      title={statusPage.title}
    />
  </body>
</html>

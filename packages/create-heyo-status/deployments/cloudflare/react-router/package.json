{
  "scripts": {
    "dev": "bun run db:migrate && heyo-status dev --transport http --port 5173 -- bunx --bun react-router dev --host 127.0.0.1 --port 5173 --strictPort",
    "start": "react-router build && wrangler dev",
    "check": null,
    "db:seed": null,
    "db:migrate": "wrangler d1 migrations apply {{PROJECT_NAME}} --local",
    "deploy": "react-router build && wrangler deploy"
  },
  "dependencies": {
    "@react-router/cloudflare": "^7.0.0"
  },
  "devDependencies": {
    "@types/react-dom": "^19.0.0",
    "wrangler": "^4.125.0"
  }
}

{
  "scripts": {
    "dev": "bun run db:migrate && heyo-status dev --transport http -- bunx --bun next dev --port 3000 --hostname 127.0.0.1",
    "start": "opennextjs-cloudflare build && wrangler dev",
    "check": null,
    "db:seed": null,
    "db:migrate": "wrangler d1 migrations apply {{PROJECT_NAME}} --local",
    "deploy": "opennextjs-cloudflare build && wrangler deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
